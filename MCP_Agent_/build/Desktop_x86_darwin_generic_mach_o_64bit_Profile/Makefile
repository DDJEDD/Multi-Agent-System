install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/MCP_Agent/bin || mkdir -p $(INSTALL_ROOT)/opt/MCP_Agent/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/MCP_Agent/bin/MCP_Agent.app
	
	$(QINSTALL) MCP_Agent.app $(INSTALL_ROOT)/opt/MCP_Agent/bin/MCP_Agent.app

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/MCP_Agent/bin/MCP_Agent.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/MCP_Agent/bin/ 


