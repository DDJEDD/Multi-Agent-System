MCP_Agent.app/Contents/PkgInfo: 
	@test -d MCP_Agent.app/Contents || mkdir -p MCP_Agent.app/Contents
	@$(DEL_FILE) MCP_Agent.app/Contents/PkgInfo
	@echo "APPL????" > MCP_Agent.app/Contents/PkgInfo
MCP_Agent.app/Contents/Info.plist: 
	@test -d MCP_Agent.app/Contents || mkdir -p MCP_Agent.app/Contents
	@$(DEL_FILE) MCP_Agent.app/Contents/Info.plist
	@set -o pipefail && plutil -convert xml1 -o - /opt/homebrew/share/qt/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.MCP-Agent,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.MCP-Agent,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},14.0,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,MCP_Agent,g" -e "s,@LIBRARY@,MCP_Agent,g" -e "s,\$${EXECUTABLE_NAME},MCP_Agent,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >MCP_Agent.app/Contents/Info.plist

